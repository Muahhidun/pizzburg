# Скопируйте в .env и заполните. .env не коммитится.
DATABASE_URL="postgresql://localhost:5432/pizzburg?schema=public"
PORT=3000
# 1 = заказы НЕ отправляются на планшеты Poster (режим разработки)
POSTER_DRY_RUN=1
# 1 = SMS не шлётся, код в логе и в ответе API (до подключения провайдера)
OTP_DEV_MODE=1
JWT_SECRET=поменяйте-в-проде
# Пароль входа в админку (заголовок X-Admin-Token)
ADMIN_TOKEN=поменяйте-в-проде

# Постоянное хранилище фотографий (AWS S3, Cloudflare R2, MinIO и аналоги)
OBJECT_STORAGE_BUCKET=pizzburg-media
OBJECT_STORAGE_REGION=auto
# Для AWS S3 можно оставить endpoint пустым; для R2:
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
# Публичный адрес bucket/custom domain без завершающего слеша
OBJECT_STORAGE_PUBLIC_URL=https://media.example.kz
# 1 обычно нужен для MinIO; для AWS S3/R2 оставьте 0
OBJECT_STORAGE_FORCE_PATH_STYLE=0

# Firebase Cloud Messaging. Сервис продолжит работать без этих переменных,
# но push-уведомления будут отключены. JSON можно передать как есть или base64.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
FCM_ENABLED=1

# Kaspi QR. По умолчанию полностью выключен. test разрешает только официальный
# mtokentest:8545; production — только https://qrapi-cert-ip.kaspi.kz (адрес
# подтверждён Kaspi 13.11.2026, порт стандартный 443).
# P12 передаётся base64-строкой через secret-переменную Railway и никогда
# не хранится файлом в репозитории.
KASPI_MODE=disabled
KASPI_BASE_URL=
# Основной вариант: P12/PFX. Для старых тестовых комплектов, которые Node.js
# не открывает, можно вместо него задать пару CLIENT_CERT + PRIVATE_KEY.
KASPI_CERT_P12_BASE64=
KASPI_CLIENT_CERT_BASE64=
KASPI_PRIVATE_KEY_BASE64=
KASPI_CERT_PASSWORD=
KASPI_ROOT_CA_BASE64=
KASPI_INTERMEDIATE_CA_BASE64=
# Для ИП здесь ИИН, несмотря на имя поля OrganizationBin в API Kaspi.
KASPI_ORGANIZATION_ID=
# Выдаётся один раз: npm run kaspi:register-device (см. скрипт).
KASPI_DEVICE_TOKEN=
KASPI_TIMEOUT_MS=15000

# Wolt Drive. Merchant Key и Venue ID хранятся поарендатно в БД и
# вводятся в админке; здесь только сетевой таймаут.
WOLT_DRIVE_TIMEOUT_MS=15000

# Подсказки адресов работают по собственному справочнику города (таблица
# Address, импорт prisma/import-addresses.ts). Внешний геокодер не нужен и
# ключа не требует — см. DECISIONS.md, раздел 11.
