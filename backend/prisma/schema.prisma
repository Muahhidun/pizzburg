// PizzBurg Delivery — схема данных (мультитенантная с первого дня)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Тенанты и точки ────────────────────────────────────────────────

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique // "pizzburg" — идёт в конфиг мобильной сборки
  name      String
  // настройки лояльности/брендинга как JSON, чтобы не плодить колонки
  settings  Json     @default("{}")
  createdAt DateTime @default(now())

  venues         Venue[]
  posterAccounts PosterAccount[]
  categories     Category[]
  products       Product[]
  customers      Customer[]
  orders         Order[]
  promoCodes     PromoCode[]
  loyaltyTxns    LoyaltyTransaction[]
  stopEvents     StopEvent[]
  upsells        UpsellItem[]
  reviews        OrderReview[]
  events         AppEvent[]
}

/// Аккаунт Poster = отдел на своём планшете. У тенанта их может быть
/// несколько (PizzBurg — фастфуд, Sunday — суши/роллы); меню сливается
/// в одно, заказ при оформлении расщепляется по отделам.
model PosterAccount {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  name      String // «Основной», «Sunday»
  token     String
  isActive  Boolean @default(true)
  sortOrder Int     @default(0) // порядок категорий этого отдела в общем меню

  categories Category[]
  products   Product[]
  dispatches OrderDispatch[]

  @@unique([tenantId, name])
}

model Venue {
  id           String  @id @default(cuid())
  tenantId     String
  tenant       Tenant  @relation(fields: [tenantId], references: [id])
  name         String
  address      String
  lat          Float?
  lng          Float?
  isActive     Boolean @default(true)
  // { mon: ["10:00","23:00"], ... }
  workingHours Json    @default("{}")

  deliveryZones DeliveryZone[]
  orders        Order[]

  @@index([tenantId])
}

model DeliveryZone {
  id          String  @id @default(cuid())
  venueId     String
  venue       Venue   @relation(fields: [venueId], references: [id])
  name        String
  // GeoJSON-полигон
  polygon     Json
  minOrder    Int     @default(0) // ₸
  deliveryFee Int     @default(0) // ₸
  freeFrom    Int? // бесплатная доставка от суммы, ₸
  isActive    Boolean @default(true)

  @@index([venueId])
}

// ─── Меню (синхронизируется из Poster) ──────────────────────────────

/// Категория ВИТРИНЫ — полностью наша сущность: своё имя, порядок,
/// видимость. Синк с Poster её не трогает. Одноимённые категории разных
/// отделов Poster сливаются в одну витринную.
model AppCategory {
  id        String  @id @default(cuid())
  tenantId  String
  name      String
  sortOrder Int     @default(0)
  isVisible Boolean @default(true)

  /// Наш стоп-лист со сроком (DECISIONS §12.3). Истёк — категория
  /// возвращается сама, без участия человека.
  stoppedUntil  DateTime?
  stoppedReason String?

  products         Product[]
  posterCategories Category[]
  stopEvents       StopEvent[]
  upsells          UpsellItem[]

  @@index([tenantId])
}

/// Что предложить добавить к заказу (DECISIONS §12.20).
///
/// Привязка к витринной категории, а не общий список на всё меню:
/// соус к пицце уместен, соус к десерту — нет, и одно неуместное
/// предложение обесценивает все остальные. `appCategoryId = null` —
/// «к любому заказу», для напитков.
model UpsellItem {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// К какой категории в корзине предлагать; null — к любому заказу
  appCategoryId String?
  appCategory   AppCategory? @relation(fields: [appCategoryId], references: [id], onDelete: Cascade)

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  @@unique([tenantId, productId, appCategoryId])
  @@index([tenantId, appCategoryId])
}

/// Категория Poster (зеркало кассы, обновляется синком).
/// appCategoryId — в какую витринную категорию по умолчанию попадают
/// новые товары этой категории кассы.
model Category {
  id              String        @id @default(cuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  posterAccountId String
  posterAccount   PosterAccount @relation(fields: [posterAccountId], references: [id])
  posterId        String? // category_id в Poster (уникален только внутри аккаунта)
  name            String
  sortOrder       Int           @default(0)
  isActive        Boolean       @default(true) // скрыта в Poster (обновляется синком)
  appCategoryId   String?
  appCategory     AppCategory?  @relation(fields: [appCategoryId], references: [id])

  products Product[]

  @@unique([posterAccountId, posterId])
  @@index([tenantId])
}

model Product {
  id              String        @id @default(cuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  posterAccountId String
  posterAccount   PosterAccount @relation(fields: [posterAccountId], references: [id])
  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id])
  posterId        String? // product_id в Poster (уникален только внутри аккаунта)
  name            String // имя в кассе (синк)
  description     String        @default("")
  photoUrl        String?
  price           Int // ₸, целые (синк)
  isActive        Boolean       @default(true) // false = стоп-лист/скрыт в Poster (синк)
  sortOrder       Int           @default(0) // порядок в Poster (синк)
  // группы модификаторов из Poster: [{name, required, options:[{name, price}]}]
  modifiers       Json          @default("[]")

  // ─ Витринные поля: правит владелец, синк не трогает ─
  appCategoryId      String?
  appCategory        AppCategory? @relation(fields: [appCategoryId], references: [id])
  displayName        String? // имя в приложении, если отличается от кассового
  displayDescription String? // описание для приложения (в кассе описаний обычно нет)
  displayPhotoUrl    String? // собственное фото витрины; приоритетнее фото Poster
  weightLabel        String? // готовая подпись: «30 см», «450 г», «8 шт.»
  isHit              Boolean      @default(false)
  isSpicy            Boolean      @default(false)
  isNew              Boolean      @default(false)
  priceOverride      Int? // ручная цена витрины; приоритет: priceOverride > цена источника «Приложение» в Poster > базовая
  sortOverride       Int? // ручной порядок внутри витринной категории
  isVisible          Boolean      @default(true)

  /// ─ Наш стоп-лист со сроком (DECISIONS §12.3) ─
  ///
  /// Третье поле, а не переиспользование двух существующих, и это
  /// принципиально. `isActive` приходит синком из Poster и молча
  /// снимался бы каждые 15 минут. `isVisible` — «убрано с витрины
  /// намеренно», такие позиции клиент не должен видеть вовсе. Наш стоп
  /// временный: позиция остаётся в каталоге неактивной, с подписью
  /// «временно недоступно», и возвращается сама по истечении срока.
  stoppedUntil  DateTime?
  stoppedReason String?

  orderItems  OrderItem[]
  comboGroups ComboGroup[]
  favorites   Favorite[]
  stopEvents  StopEvent[]
  upsells     UpsellItem[]

  @@unique([posterAccountId, posterId])
  @@index([tenantId, categoryId])
}

/// История стоп-листа: что стояло, сколько времени и сколько раз.
///
/// Без неё наблюдаемость теряется в тот же день: как только срок
/// истекает, `stoppedUntil` обнуляется и факт стопа исчезает бесследно.
/// А весь смысл §12.3 — видеть, что и как часто снимают с продажи.
model StopEvent {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  productId     String?
  product       Product?     @relation(fields: [productId], references: [id])
  appCategoryId String?
  appCategory   AppCategory? @relation(fields: [appCategoryId], references: [id])
  reason        String       @default("")
  startedAt     DateTime     @default(now())
  /// Плановый срок возврата — тот, что выбрал человек
  until         DateTime
  /// Когда позиция вернулась на самом деле
  endedAt       DateTime?
  /// EXPIRED — вернулась по сроку, MANUAL — вернули досрочно
  endedBy       String?

  @@index([tenantId, startedAt])
}

/// Группа выбора в комбо-товаре («Основное блюдо», «Напиток», «Добавка»).
/// У SmartPicasso это были служебные категории с нулевыми позициями —
/// у нас это своя механика поверх обычного товара Poster.
model ComboGroup {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String
  minSelect Int     @default(1)
  maxSelect Int     @default(1)
  sortOrder Int     @default(0)

  options ComboOption[]

  @@index([productId])
}

model ComboOption {
  id              String     @id @default(cuid())
  groupId         String
  group           ComboGroup @relation(fields: [groupId], references: [id])
  name            String
  priceDelta      Int        @default(0) // 0 = входит в цену, >0 = доплата (апгрейд)
  photoUrl        String?
  posterProductId String? // соответствующая позиция Poster для чека (если есть)
  isDefault       Boolean    @default(false)
  sortOrder       Int        @default(0)
  isActive        Boolean    @default(true)

  @@index([groupId])
}

// ─── Клиенты и авторизация ──────────────────────────────────────────

model Customer {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  phone         String // идентификатор клиента (как у FoodPicasso — сохранит профили при миграции)
  name          String?
  birthday      DateTime?
  pointsBalance Int       @default(0) // балл = 1 ₸
  loyaltyLevel  Int       @default(1)
  /// Сумма выполненных заказов за всё время, ₸ — база для уровня кэшбэка.
  /// Считаем за всю жизнь, а не за скользящий год: уровень никогда не
  /// понижается. Понижение — гарантированный скандал («я был постоянным,
  /// а вы меня понизили»), а объяснять правило проще некуда.
  lifetimeSpent Int       @default(0)
  pushToken     String? // устаревшее поле; новые токены хранятся в PushDevice
  createdAt     DateTime  @default(now())

  /// Согласие с офертой и политикой: { "OFFER": 3, "PRIVACY": 1 }
  /// Храним версии, а не флаг: при выпуске новой редакции согласие
  /// нужно запросить заново, и это должно быть видно.
  legalVersions   Json      @default("{}")
  legalAcceptedAt DateTime?

  orders          Order[]
  loyaltyTxns     LoyaltyTransaction[]
  pushDevices     PushDevice[]
  addresses       CustomerAddress[]
  favorites       Favorite[]
  addressRequests AddressRequest[]
  events          AppEvent[]

  @@unique([tenantId, phone])
}

/// Товар в избранном у клиента.
///
/// Отдельная таблица, а не массив id в профиле: по ней сразу считается

/// Сообщение ленты: акция, новость, объявление заведения.
///
/// Лента — собственный канал владельца: пуш живёт секунды, а сообщение
/// остаётся в приложении, и клиент может вернуться к нему за условиями
/// акции. Аудитория одна — все клиенты города; сегментации намеренно нет,
/// пока для неё нет реальной задачи.
model Message {
  id       String @id @default(cuid())
  tenantId String

  title String
  body  String

  /// Картинка не обязательна: объявление «завтра работаем до 20:00»
  /// не должно требовать дизайнера
  imageUrl String?

  /// Снятое с публикации сообщение остаётся в базе: история рассылок —
  /// тоже документ
  isPublished Boolean @default(true)

  /// Когда ушёл пуш; null — рассылки не было
  pushSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, isPublished, createdAt])
}

/// Справочник адресов города.
///
/// Свой, а не внешний сервис: оформление заказа — самое дорогое место в
/// приложении, и оно не должно падать вместе с чужим API. Заодно справочник
/// работает зоной доставки: адрес есть, но `isDeliverable = false` — и он
/// просто не предлагается.
///
/// Источник — OpenStreetMap (ODbL), импорт `prisma/import-addresses.ts`.
/// Атрибуция «© OpenStreetMap contributors» обязательна и стоит в «О
/// приложении».
model Address {
  id       String @id @default(cuid())
  tenantId String

  street String
  house  String

  /// Координаты нужны будущим зонам доставки и курьеру; у части адресов
  /// их может не быть — это не повод не показывать адрес.
  lat Float?
  lng Float?

  /// Куда не возим. Адрес остаётся в базе, но в подсказках не появляется:
  /// удалять его нельзя — иначе следующий импорт вернёт его обратно.
  isDeliverable Boolean @default(true)

  /// OSM — пришёл импортом, MANUAL — завёл оператор. Импорт не трогает
  /// MANUAL: адрес, добавленный руками по жалобе клиента, важнее выгрузки.
  source String @default("OSM")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, street, house])
  @@index([tenantId, street])
}

/// «Моего адреса нет в списке» — заявка клиента.
///
/// Закрытый справочник рано или поздно не найдёт реальный адрес реального
/// человека: новый дом, переименованная улица. Без этой лазейки он просто
/// не сможет заказать, и мы узнаем об этом только по потерянной выручке.
model AddressRequest {
  id       String @id @default(cuid())
  tenantId String

  /// Что человек написал руками
  raw String

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  phone      String?

  /// Оператор разобрался: добавил в справочник или отклонил
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId, resolvedAt])
}

/// «сколько человек добавили это блюдо» — пригодится, чтобы понимать, что
/// любят, и не гадать по продажам.
model Favorite {
  id         String   @id @default(cuid())
  tenantId   String
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  /// Повторное нажатие сердечка не должно плодить строки
  @@unique([customerId, productId])
  @@index([tenantId, productId])
}

/// Адрес клиента для повторных заказов.
///
/// Копия адреса всё равно остаётся в `Order.address`: справочник можно
/// отредактировать или удалить, а заказ должен помнить, куда его везли.
model CustomerAddress {
  id         String   @id @default(cuid())
  tenantId   String
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  street   String
  house    String
  /// Пустая строка, а не NULL: поле входит в ключ дубликата, а в Postgres
  /// NULL != NULL — с nullable-колонкой уникальность просто не сработала бы.
  flat     String  @default("")
  entrance String?
  floor    String?
  comment  String?
  /// «Дом», «Работа» — необязательная подпись от клиента
  label    String?

  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  /// Один и тот же адрес не должен накапливаться дублями при каждом заказе
  @@unique([customerId, street, house, flat])
  @@index([customerId, lastUsedAt])
}

enum LegalDocumentType {
  OFFER // публичная оферта
  PRIVACY // политика конфиденциальности
  REQUISITES // реквизиты продавца
}

/// Версионируемый юридический документ.
/// Нужен для ревью App Store и Google Play и как доказательство того,
/// с какой редакцией согласился клиент. Старые версии не удаляются.
model LegalDocument {
  id          String            @id @default(cuid())
  tenantId    String
  type        LegalDocumentType
  version     Int
  title       String
  /// Markdown; приложение и сайт рендерят как есть
  content     String
  isCurrent   Boolean           @default(false)
  publishedAt DateTime          @default(now())

  @@unique([tenantId, type, version])
  @@index([tenantId, type, isCurrent])
}

/// Справочник причин отмены — иначе отчёт по отменам не построить:
/// свободный текст кассира не сгруппировать.
model CancelReason {
  id                  String  @id @default(cuid())
  tenantId            String
  label               String
  sortOrder           Int     @default(0)
  isActive            Boolean @default(true)
  /// Показывать ли причину клиенту в приложении
  availableToCustomer Boolean @default(false)

  orders Order[]

  @@unique([tenantId, label])
  @@index([tenantId])
}

enum PushPlatform {
  IOS
  ANDROID
  WEB
  UNKNOWN
}

/// Отдельная запись на каждую установку приложения. Один клиент может
/// одновременно пользоваться несколькими телефонами и веб-приложением.
model PushDevice {
  id         String       @id @default(cuid())
  customerId String
  customer   Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  token      String       @unique
  platform   PushPlatform @default(UNKNOWN)
  appVersion String?
  isEnabled  Boolean      @default(true)
  lastSeenAt DateTime     @default(now())
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([customerId, isEnabled])
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
}

// ─── Заказы ─────────────────────────────────────────────────────────

enum OrderType {
  DELIVERY
  PICKUP
}

enum OrderStatus {
  NEW
  ACCEPTED
  COOKING
  READY
  ON_WAY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD_ON_DELIVERY
  KASPI_ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  NOT_REQUIRED // оплата при получении
}

/// Разбирательство по нехватке позиции (DECISIONS §12.9).
///
/// Живёт отдельно от OrderStatus, а не новым его значением: основной
/// отдел принимает и готовит свою часть, не дожидаясь ответа клиента,
/// поэтому заказ вполне может быть ACCEPTED и одновременно ждать выбора
/// по позиции второго отдела. Свести это в одну шкалу — значит соврать
/// либо кухне, либо клиенту.
enum ShortageState {
  /// Всё на месте — обычный ход заказа
  NONE
  /// Кассир отметил позицию, клиент выбирает: везти без неё или отменить
  AWAITING_CUSTOMER
  /// Везём остальное. Кто решил — в shortageResolvedBy
  KEPT_REST
  /// Клиент отказался от заказа целиком
  CANCELLED_BY_CUSTOMER
}

model Order {
  id                 String        @id @default(cuid())
  tenantId           String
  tenant             Tenant        @relation(fields: [tenantId], references: [id])
  venueId            String
  venue              Venue         @relation(fields: [venueId], references: [id])
  customerId         String?
  customer           Customer?     @relation(fields: [customerId], references: [id])
  number             Int // человекочитаемый номер, сквозной по тенанту
  type               OrderType
  status             OrderStatus   @default(NEW)
  // { street, house, flat, entrance, floor, comment, lat, lng }
  address            Json?
  scheduledAt        DateTime? // предзаказ; null = как можно скорее
  comment            String        @default("")
  subtotal           Int // ₸ до скидок
  deliveryFee        Int           @default(0)
  discount           Int           @default(0) // вся выгода: подарки + скидка + баллы
  /// Денежная скидка по акциям, ₸. Отдельным полем, а не внутри discount:
  /// при отправке в Poster её нужно прибавить к «Личной интеграции», и
  /// вычислить её обратно из общей суммы выгоды нельзя.
  promoDiscount      Int           @default(0)
  pointsSpent        Int           @default(0)
  pointsEarned       Int           @default(0)
  total              Int
  paymentMethod      PaymentMethod
  paymentStatus      PaymentStatus @default(NOT_REQUIRED)
  promoCode          String?
  /// Купюра для сдачи при оплате наличными; кассир готовит размен
  changeFrom         Int?
  /// Свободный комментарий к отмене
  cancelReason       String?
  /// Причина из справочника — по ней строится отчёт
  cancelReasonId     String?
  cancelReasonRef    CancelReason? @relation(fields: [cancelReasonId], references: [id])
  /// Кто отменил: CUSTOMER | ADMIN | POSTER — для отчёта по отменам
  cancelledBy        String?
  cancelledAt        DateTime?
  /// Версии документов, действовавшие при оформлении — доказательство
  /// согласия именно на эту редакцию
  legalVersions      Json?
  // ─ Нехватка позиции (DECISIONS §12.9) ─────────────────────────────
  shortageState      ShortageState @default(NONE)
  /// Когда кассир отметил нехватку — по нему в консоли видно, сколько висит
  shortageAt         DateTime?
  /// До этого момента ждём ответа клиента; истёк — везём остальное
  shortageDeadline   DateTime?
  /// CUSTOMER | TIMEOUT — кто закрыл вопрос. Разница нужна кассиру:
  /// после TIMEOUT человек ещё не знает, что везём без позиции
  shortageResolvedBy String?
  shortageResolvedAt DateTime?
  /// Когда заказ можно отправлять на планшеты (DECISIONS §12.12).
  ///
  /// Пока идёт окно отмены, заказ у нас уже есть, а в кассе его ещё нет:
  /// клиент отменяет — и отклонять на планшете нечего, кассир о заказе
  /// даже не узнаёт. Срок хранится в базе, а не таймером в памяти:
  /// перезапуск контейнера убил бы таймер, и заказ не уехал бы вовсе —
  /// клиент ждал бы еду, которую никто не готовит.
  dispatchAfter      DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  items         OrderItem[]
  dispatches    OrderDispatch[]
  loyaltyTxns   LoyaltyTransaction[]
  messages      OrderMessage[]
  /// Когда спросили впечатления. Пусто — ещё не спрашивали
  reviewAskedAt DateTime?
  review        OrderReview?

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  /// Фоновая задача ищет просроченные ожидания раз в минуту
  @@index([shortageState, shortageDeadline])
  /// Фоновая отправка ищет созревшие заказы каждые несколько секунд
  @@index([dispatchAfter])
}

/// Отправка части заказа в конкретный отдел (аккаунт Poster).
/// Заказ «пицца + роллы» породит две отправки — на два планшета.
model OrderDispatch {
  id              String        @id @default(cuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id])
  posterAccountId String
  posterAccount   PosterAccount @relation(fields: [posterAccountId], references: [id])
  posterOrderId   String? // incoming_order_id в этом аккаунте Poster
  // PENDING | SENT | FAILED | VOID (в части не осталось позиций)
  status          String        @default("PENDING")
  // статус на планшете: NEW | ACCEPTED | REJECTED (поллинг Poster)
  posterStatus    String?
  error           String?
  /// Отменённые чеки этой части: [{ posterOrderId, replacedAt }].
  ///
  /// Poster не умеет менять состав уже отправленного входящего заказа —
  /// в API есть только создание и чтение. Поэтому исправленный после
  /// нехватки состав уходит НОВЫМ входящим заказом, а старый кассир
  /// отклоняет на планшете. Здесь хранится, что именно она отклоняет:
  /// иначе при разборе смены два чека на один заказ выглядят как дубль.
  replacedOrders  Json          @default("[]")
  createdAt       DateTime      @default(now())

  @@unique([orderId, posterAccountId])
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id])
  productId     String?
  product       Product? @relation(fields: [productId], references: [id])
  // снапшоты на момент заказа — меню меняется, чек неизменен
  name          String
  price         Int
  qty           Int
  // выбранные модификаторы: [{name, price}]
  modifiers     Json     @default("[]")
  // подарок по акции: клиент не платит, в Poster уходит полной ценой,
  // компенсируется «Личной интеграцией»
  isGift        Boolean  @default(false)
  /// Позиции не оказалось — кассир отметил её в консоли (DECISIONS §12.9).
  ///
  /// Строка не удаляется, а гасится: в кассу и в сумму она больше не
  /// попадает, но и клиенту, и разбору смены нужно видеть, чего именно
  /// не привезли. Удалённая строка не оставила бы следа.
  isUnavailable Boolean  @default(false)

  @@index([orderId])
}

// ─── Лояльность и промо ─────────────────────────────────────────────

enum LoyaltyTxnType {
  EARN
  SPEND
  ADJUST // ручная корректировка / миграционный импорт
}

model LoyaltyTransaction {
  id         String         @id @default(cuid())
  tenantId   String
  tenant     Tenant         @relation(fields: [tenantId], references: [id])
  customerId String
  customer   Customer       @relation(fields: [customerId], references: [id])
  orderId    String?
  order      Order?         @relation(fields: [orderId], references: [id])
  type       LoyaltyTxnType
  amount     Int // ₸/баллы, знак по типу
  comment    String         @default("")
  createdAt  DateTime       @default(now())

  @@index([tenantId, customerId])
  @@index([orderId, type])
}

/// Акция уровня приложения. Первый поддержанный тип — «N товаров из
/// категории → товар в подарок» (2+1). Скидка при отправке в Poster
/// уходит «Личной интеграцией» (payment.sum), позиции — полными ценами.
/// Что акция делает. Тип определяет, какие поля условия и эффекта читаются.
enum PromotionKind {
  /// N товаров из категории → подарок (классическая «2+1»)
  GIFT_FOR_QTY
  /// Сумма заказа не меньше minOrderSum → подарок
  GIFT_FOR_SUM
  /// Скидка процентом на заказ
  PERCENT_OFF
  /// Скидка фиксированной суммой
  FIXED_OFF
  /// Бесплатная доставка
  FREE_DELIVERY
}

model Promotion {
  id       String        @id @default(cuid())
  tenantId String
  name     String // «2+1 Пицца»
  kind     PromotionKind @default(GIFT_FOR_QTY)
  code     String? // промокод; null = применяется автоматически
  isActive Boolean       @default(true)

  // --- условия ---
  /// Витринная категория (AppCategory) для GIFT_FOR_QTY
  conditionCategoryId String?
  conditionQty        Int     @default(2)
  /// Минимальная сумма товаров, ₸. Для GIFT_FOR_SUM обязательна,
  /// остальным типам служит дополнительным порогом.
  minOrderSum         Int?

  // --- эффект ---
  giftProductId String?
  giftQty       Int     @default(1)
  /// Проценты для PERCENT_OFF, тенге для FIXED_OFF
  discountValue Int     @default(0)
  /// Потолок скидки в ₸ для процента: без него «−50%» на крупном заказе
  /// уносит выручку смены.
  maxDiscount   Int?

  // --- ограничения ---
  repeatPerCart    Boolean @default(true) // «много раз в рамках чека»
  /// Только первый заказ клиента
  firstOrderOnly   Boolean @default(false)
  /// Сколько раз одному клиенту; null = без ограничения
  perCustomerLimit Int?
  /// Сколько раз всего; null = без ограничения
  totalLimit       Int?
  /// 'DELIVERY' | 'PICKUP'; null = любой способ получения
  orderType        String?

  activeFrom DateTime?
  activeTo   DateTime?

  uses PromotionUse[]

  @@index([tenantId])
}

/// Факт применения акции к заказу.
///
/// Без этой таблицы ограничения «первый заказ» и «раз на клиента»
/// проверить нечем: акции не хранят историю, а по заказам скидку уже не
/// разложить обратно на акции.
model PromotionUse {
  id          String    @id @default(cuid())
  tenantId    String
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  customerId  String?
  orderId     String
  /// Сколько дала эта акция в ₸ — для отчёта об эффективности
  discount    Int       @default(0)
  createdAt   DateTime  @default(now())

  /// Повторная отправка заказа не должна удваивать счётчик применений
  @@unique([promotionId, orderId])
  @@index([promotionId, customerId])
  @@index([tenantId, createdAt])
}

enum PromoType {
  FIXED // −N ₸
  PERCENT // −N %
  GIFT // подарочная позиция (2+1 и т.п.)
}

/// УСТАРЕЛО. Резервная схема промокодов, которую движок никогда не читал:
/// все правила живут в Promotion. Не удаляем здесь, чтобы не тянуть DROP
/// таблицы в деплой боевой базы — снос отдельной миграцией.
model PromoCode {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  code       String
  type       PromoType
  value      Int // ₸ | % | productId-ссылка в config
  // условия: { minOrder, giftProductId, requiredQty, ... }
  config     Json      @default("{}")
  activeFrom DateTime?
  activeTo   DateTime?
  usageLimit Int? // на клиента
  isActive   Boolean   @default(true)

  @@unique([tenantId, code])
}

/// Обращение клиента по живому заказу (DECISIONS §12.21).
///
/// Телефон кассы не публикуется: звонок сбивает смену, где одновременно
/// идут зал, агрегаторы и наши заказы. Обращение письменное, привязано к
/// заказу и уже размечено темой — кассир видит запрос, а не абзац.
model OrderMessage {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Тема из готового списка; свободный текст — дополнение к ней
  topic     String
  text      String   @default("")
  createdAt DateTime @default(now())

  /// Ответ заведения. Пишет его пока некому — механизм будет в §12.27,
  /// — но место под него заведено сразу: без ответа лента обращений
  /// показывает только половину разговора, и понять, разобрались ли с
  /// человеком, по ней нельзя.
  answeredAt DateTime?
  answeredBy String?
  answerText String?

  @@index([orderId, createdAt])
}

/// Впечатление о заказе (DECISIONS §12.23).
///
/// Не звёзды: прямая оценка даёт либо пять, либо один — среднего люди не
/// ставят. Спрашиваем факты по нескольким сторонам заказа, а оценку
/// выводим сами.
model OrderReview {
  id       String @id @default(cuid())
  orderId  String @unique
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  /// { timing: 'ON_TIME', complete: 'YES', ... } — ключи вопросов
  answers Json
  /// 1–5, посчитана из ответов
  rating  Int
  text    String  @default("")
  /// Ушло ли в чаты: низкая оценка требует человека, хорошая — нет
  alerted Boolean @default(false)

  /// Ответ заведения на отзыв — тем же местом, что и у обращений
  answeredAt DateTime?
  answeredBy String?
  answerText String?

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

/// Поведенческое событие (DECISIONS §12.24).
///
/// Заказы отвечают, что купили. Эти события отвечают, что смотрели и не
/// купили, — а это разные вопросы, и второй важнее для решений «что
/// убрать из меню» и «работают ли допродажи». Задним числом такие данные
/// не восстановить: не записал в тот день — не узнаешь никогда.
model AppEvent {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  /// Тип из белого списка на сервере: свободные строки превращают
  /// таблицу в свалку, по которой нельзя построить ни одного отчёта
  type String

  /// Кто, если вошёл. Гость смотрит меню, не входя, и его поведение
  /// тоже важно — его опознаём по устройству
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  deviceId   String?

  /// Полезная нагрузка под тип: { query, results } у поиска,
  /// { productId } у просмотра
  payload Json @default("{}")

  /// Время на устройстве могло уехать, поэтому пишем серверное
  at DateTime @default(now())

  @@index([tenantId, type, at])
  @@index([tenantId, at])
  @@index([customerId, at])
}
